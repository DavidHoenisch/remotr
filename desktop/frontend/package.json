{
  "name": "remotr-desktop-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
