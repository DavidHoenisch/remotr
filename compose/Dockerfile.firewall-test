FROM debian:bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    firewalld \
    nftables \
    dbus \
    ca-certificates \
    curl \
    git \
    make \
    golang-go \
    && rm -rf /var/lib/apt/lists/*

# Ensure firewalld can start without systemd (it will run in the foreground or via dbus)
RUN mkdir -p /etc/firewalld/zones

WORKDIR /workspace
